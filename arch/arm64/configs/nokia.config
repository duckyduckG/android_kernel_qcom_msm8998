# Platform
CONFIG_FIH_SDM630_SDM660_PROJS=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_COMPAT_VDSO=y

# A/B
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# Debug
CONFIG_QCOM_PRESERVE_MEM=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_FTRACE=y

# WERROR
CONFIG_CC_WERROR=n

# FIH
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_NFC=y
CONFIG_NTFS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_BPF_SYSCALL=y
CONFIG_WIREGUARD=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_USB_OTG=y
CONFIG_USB_MSM_OTG=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_CGROUP_BPF=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_THIN_ARCHIVES=y
CONFIG_OVERLAY_FS=y
CONFIG_IOSCHED_BFQ=y
CONFIG_SDFAT_FS=y
CONFIG_BLK_CGROUP=y

# Disable debug by fih
# CONFIG_SKY2 is not set
# CONFIG_SMSC911X is not set
# CONFIG_INPUT_HBTP_INPUT is not set
# CONFIG_SERIAL_MSM is not set
# CONFIG_SERIAL_MSM_CONSOLE is not set
