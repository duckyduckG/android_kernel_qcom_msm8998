# Platform
CONFIG_FIH_SDM630_SDM660_PROJS=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_COMPAT_VDSO=y

# A/B
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# BPF
CONFIG_BPF_SYSCALL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_CGROUP_BPF=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Debug
CONFIG_QCOM_PRESERVE_MEM=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_FTRACE=y

# Power
CONFIG_CHARGER_BQ25600_SLAVE=y
CONFIG_WIRELESS_CHARGER_STWLC33=y
CONFIG_WIRELESS_CHARGER_P9221=y

# HAPTICS
# CONFIG_LEDS_QPNP_HAPTICS is not set

# FIH drivers
CONFIG_LEDS_AW2015=y
CONFIG_INPUT_AH1902=y
CONFIG_INPUT_DRV2605_HAPTICS=y
CONFIG_TOUCHSCREEN_ILI210X_FIH=y
CONFIG_TOUCHSCREEN_FTS_FIH=y
CONFIG_TOUCHSCREEN_NT36xxx_FIH=y
CONFIG_TOUCHSCREEN_GX_FIH=y
CONFIG_TOUCHSCREEN_GT9XX_FIH=y
CONFIG_TOUCHSCREEN_FT8719_FIH=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_INPUT_FPC1020=y
CONFIG_INPUT_GF5288=y
CONFIG_ELAN_614R=y
CONFIG_BOOST_CONVERTER_SUPPORT=y
CONFIG_BOOST_NT50356=y
CONFIG_PXLW_IRIS3=y
# TI TAS2557 SMART AMP -- 20170717@ray
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_REGMAP=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y
# TI TAS2560 SMART AMP -- 20170717@rita
CONFIG_SND_SOC_TAS2560=y
CONFIG_TAS2560_REGMAP=y
CONFIG_TAS2560_CODEC=y
CONFIG_TAS2560_MISC=y
# TFA9891
CONFIG_SND_SOC_TFA9891=y

# FIH Specific
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_NFC=y
CONFIG_NTFS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_WIREGUARD=y
CONFIG_USB_OTG=y
CONFIG_USB_MSM_OTG=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_THIN_ARCHIVES=y
CONFIG_OVERLAY_FS=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BLK_CGROUP=y
CONFIG_USB_CONFIGFS_SERIAL=y

# Disable debug by FIH
